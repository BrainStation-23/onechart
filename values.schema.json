{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "autoscaling": {
      "type": "object",
      "required": [
        "enabled",
        "maxReplicas"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetCPUUtil": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "targetMemoryUtil": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "behavior": {
          "type": "object"
        }
      }
    }
  }
}
